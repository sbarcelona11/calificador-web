{
  "env": {
    "browser": true,
    "node": true,
    "es2017": true
  },
  "parserOptions": {
    "ecmaVersion": 2018
  },
  "extends": "eslint:recommended",
  "globals": {
    "Core": "readonly",
    "XLSX": "readonly",
    "JSZip": "readonly"
  },
  "rules": {
    "no-unused-vars": ["warn", { "args": "none" }],
    "no-constant-condition": "off"
  }
}
